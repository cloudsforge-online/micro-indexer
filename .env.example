# cloudsforge-indexer
#
# Every variable this service reads is declared in src/env.ts and nowhere else, and this file is
# the complete list. Rule 9 of docs/ecosystem/03 §2: a repo declares the variables it needs and
# the deploy provides exactly those — never `env_file: .env`, which is how the game container
# ended up holding the custody master secret.

# --------------------------------------------------------------------------------- process
PORT=4008
NODE_ENV=development
LOG_LEVEL=info
# The release tag. One value across the estate; see 09-release-roadmap §1.
CLOUDSFORGE_TAG=dev
# Names this replica in jobs.locked_by. Defaults to the hostname, which is the container id under
# compose and the pod name under Kubernetes — in both cases the thing to search for after finding
# a stuck lease.
# INSTANCE_ID=

# --------------------------------------------------------------------------------- data
# Rule 1: one database, named by this service's own variable. A second connection-string variable
# fails CI rather than review.
INDEXER_DATABASE_URL=postgres://cloudsforge:changeme@127.0.0.1:5432/indexer
INDEXER_DATABASE_POOL_MAX=10

# --------------------------------------------------------------------------------- identity
IDENTITY_JWKS_URL=http://127.0.0.1:4001/.well-known/jwks.json
IDENTITY_ISSUER=http://127.0.0.1:4001

# HMAC key for outbound event signatures, so a subscriber can prove an event came from us.
# At least 24 characters, and a known placeholder is refused outright: a default secret in source
# is not convenient, it is catastrophic.
OUTBOX_SIGNING_SECRET=

# --------------------------------------------------------------------------------- chains
# Which (chain, network) pairs this deployment follows. Empty is legal — a replica may serve reads
# and follow nothing. A chain named here MUST have an endpoint variable below, and an endpoint
# variable with no chain named here is refused: a follower with no provider reports healthy and
# indexes nothing, which is the failure mode of the balance-probing this service replaces.
INDEXER_CHAINS=ember:testnet

# `name=url` pairs, comma separated, in preference order. The pool reorders by health; declaration
# order breaks ties. The NAME is the primary key of provider_health and the `provider` label of
# indexer_provider_failures_total, so two endpoints at one host must be named by hand.
# Only the host is ever stored or logged — an RPC URL's query string is where an API key lives.
INDEXER_RPC_EMBER_TESTNET=hearth-local=http://127.0.0.1:8545

# Where a cold start begins, per chain. Omit for "the tip, less twice the confirmation depth",
# which is the smallest window that can watch a deposit through its whole confirmation life.
# Older history is a backfill job (POST /v1/backfills/:chain/:network), not a cold start.
# INDEXER_START_HEIGHT_EMBER_TESTNET=

# --------------------------------------------------------------------------------- tuning
# Blocks per follower tick. Bounded because a tick must finish inside its job lease; raising this
# without raising the lease is how two replicas end up following one chain.
INDEXER_FOLLOW_BATCH_BLOCKS=25
# The same bound for a backfill pass. Separate, because backfill is allowed to be slower.
INDEXER_BACKFILL_BATCH_BLOCKS=50
# Absolute wall-clock ceiling for one RPC call, across the transport's own retries.
INDEXER_RPC_DEADLINE_MS=8000

# Write address_activity for watched addresses only, on the Bitcoin-family chains.
#
# On, because following ltc:mainnet costs 2.05 MB per block with indexes and the watched set does
# not move: the cost is the chain's transaction volume, and btc:mainnet on top of it fills the
# host's disk in under two months. Off restores the general record — the block explorer's address
# pages and wallet's portfolio for external wallets read it for addresses nobody registered — at
# that price. Blocks walked with this on are marked partial in blocks.detail, so turning it off
# later tells you what to backfill instead of leaving you to guess.
INDEXER_WATCHED_ADDRESSES_ONLY=true

# ------------------------------------------------------------------------------ custody total
# GET /custody/:chain/:network/total is Σ confirmed native balance over the custody set, and it is
# the number micro-ledger reconciles its custody accounts against. Until it existed, no service in
# the estate could supply one, so every reconciliation compared the ledger against the ledger.
#
# WHICH WATCHED ADDRESSES ARE CUSTODY'S, by label prefix. `deposit:` is what micro-wallet writes
# for every assigned deposit address (wallet/src/deposits.ts:284), and coin arriving there is
# debited to the ledger's custody asset account — so those addresses ARE the custody position.
# `treasury:` is carried but NOTHING WRITES IT TODAY: micro-settlement sweeps deposits to a pinned
# treasury address and holds no indexer:write grant, so a swept deployment under-reports here.
# That reads at the ledger as positive drift and FREEZES the asset, which is the safe direction
# and is loud; the fix is a registration in micro-settlement, not a change to this value.
#
# An empty list is REFUSED rather than treated as "everything": a set that matches nothing sums to
# zero over zero addresses, and zero standing in for "we did not look" is the whole defect this
# path exists to remove. A prefix containing % or _ is refused too.
INDEXER_CUSTODY_LABEL_PREFIXES=deposit:,treasury:
# The largest custody set one observation will attempt — one eth_getBalance per address inside one
# request. Above this the route answers 503 custody_set_too_large rather than summing a page,
# because a page of a custody set is a partial sum and a partial sum freezes withdrawals.
INDEXER_CUSTODY_MAX_ADDRESSES=2000
# How many of those reads are in flight at once. Bounded because a provider throttling a burst
# answers with 429s, and every 429 here is a refusal — so unbounded parallelism turns a healthy
# provider into a frozen asset.
INDEXER_CUSTODY_CONCURRENCY=8

# --------------------------------------------------------------------------------- tests
# Database tests skip unless this is set AND its name contains "test", because they truncate.
# INDEXER_TEST_DATABASE_URL=postgres://cloudsforge:changeme@127.0.0.1:5432/indexer_test
# The integration test skips cleanly when no node answers here.
# INDEXER_HEARTH_RPC_URL=http://127.0.0.1:8545
